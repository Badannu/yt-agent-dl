{
  "manifest_version": 3,
  "name": "YT Cookie Auto Sync",
  "version": "1.0.0",
  "description": "定时自动导出浏览器全量 cookie 为 Netscape 格式，供 yt-dlp / ytDownloader 使用，无需手动点击导出。支持 Chrome、Edge 等 Chromium 浏览器。",
  "permissions": [
    "cookies",
    "downloads",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YT Cookie Auto Sync",
    "default_popup": "popup.html"
  }
}
